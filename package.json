    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "dependencies": {
    "@formspree/react": "^3.0.0",
    "@microsoft/clarity": "^1.0.2",
    "@vercel/analytics": "^2.0.1",

    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router": "7.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "gh-pages": "^6.3.0",
    "sharp": "^0.34.5",
    "subset-font": "^2.5.0",
    "tailwindcss": "4.1.12",
    "vite": "^6.4.2",
    "vite-plugin-compression2": "^2.5.3"

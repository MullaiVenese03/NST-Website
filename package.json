  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "build": "node scripts/generate-sitemap.mjs && node scripts/generate-favicons.mjs && node scripts/optimize-og.mjs && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "optimize:fonts": "node scripts/optimize-fonts.mjs",
